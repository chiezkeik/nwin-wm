index 0000000..a3ce504
--- /dev/null
+++ b/runners/nwin/nwin-runner.cpp
@@ -0,0 +1,79 @@
+/*
+    SPDX-FileCopyrightText: 2009 Aaron Seigo <aseigo@kde.org>
+    SPDX-FileCopyrightText: 2016 Martin Gräßlin <mgraesslin@kde.org>
+
+    SPDX-License-Identifier: LGPL-2.0-only
+*/
+
+#include "nwin-runner.h"
+
+#include <QDBusConnection>
+#include <QDBusConnectionInterface>
+#include <QDBusServiceWatcher>
+
+#include <KLocalizedString>
+#include <KWindowSystem>
+
+K_PLUGIN_CLASS_WITH_JSON(NWinRunner, "plasma-runner-nwin.json")
+
+static const QString s_compositorService = KWindowSystem::isPlatformX11() ? QStringLiteral("org.kde.KWin") : QStringLiteral("org.kde.NWin");
+static const QString s_keyword = KWindowSystem::isPlatformX11() ? QStringLiteral("kwin debug console") : QStringLiteral("nwin debug console");
+static const QStringList s_keywords = {KWindowSystem::isPlatformX11() ? QStringLiteral("kwin") : QStringLiteral("nwin"), QStringLiteral("debug"), QStringLiteral("console")};
+
+NWinRunner::NWinRunner(QObject *parent, const KPluginMetaData &metaData)
+    : AbstractRunner(parent, metaData)
+{
+    QDBusServiceWatcher *watcher = new QDBusServiceWatcher(s_compositorService, QDBusConnection::sessionBus(), QDBusServiceWatcher::WatchForOwnerChange, this);
+    connect(watcher, &QDBusServiceWatcher::serviceOwnerChanged, this, &NWinRunner::checkAvailability);
+    checkAvailability(QString(), QString(), QString());
+}
+
+void NWinRunner::match(RunnerContext &context)
+{
+    const bool containsAnyKeyword = std::any_of(s_keywords.begin(), s_keywords.end(), [&context](const QString &keyword) {
+        return context.query().contains(keyword, Qt::CaseInsensitive);
+    });
+    if (m_enabled && containsAnyKeyword) {
+        QueryMatch match(this);
+        match.setId(KWindowSystem::isPlatformX11() ? QStringLiteral("kwin") : QStringLiteral("nwin"));
+        if (context.query().compare(s_keyword, Qt::CaseInsensitive) == 0) {
+            match.setCategoryRelevance(QueryMatch::CategoryRelevance::Highest);
+        }
+        match.setIconName(KWindowSystem::isPlatformX11() ? QStringLiteral("kwin") : QStringLiteral("nwin"));
+        match.setText((KWindowSystem::isPlatformX11() ? i18n("Open KWin debug console") : i18n("Open NWin debug console")));
+        match.setRelevance(1.0);
+        context.addMatch(match);
+    }
+}
+
+void NWinRunner::run(const RunnerContext & /*context*/, const QueryMatch & /*match*/)
+{
+    if (m_enabled) {
+        QDBusMessage message = QDBusMessage::createMethodCall(s_compositorService, (KWindowSystem::isPlatformX11() ? QStringLiteral("/KWin") : QStringLiteral("/NWin")), s_compositorService, QStringLiteral("showDebugConsole"));
+        QDBusConnection::sessionBus().asyncCall(message);
+    }
+}
+
+void NWinRunner::checkAvailability(const QString &name, const QString & /*oldOwner*/, const QString &newOwner)
+{
+    bool enabled = false;
+    if (name.isEmpty()) {
+        enabled = QDBusConnection::sessionBus().interface()->isServiceRegistered(s_compositorService).value();
+    } else {
+        enabled = !newOwner.isEmpty();
+    }
+
+    if (m_enabled != enabled) {
+        m_enabled = enabled;
+
+        if (m_enabled) {
+            RunnerSyntax(s_keywords, (KWindowSystem::isPlatformX11() ? i18n("Opens the KWin (Plasma Window Manager) debug console.") : i18n("Opens the NWin (Plasma Window Manager) debug console.")));
+        } else {
+            setSyntaxes(QList<RunnerSyntax>());
+        }
+    }
+}
+
+#include "nwin-runner.moc"
+
+#include "moc_nwin-runner.cpp"
