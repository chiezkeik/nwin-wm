+# SPDX-License-Identifier: BSD-3-Clause
+# SPDX-FileCopyrightText: 2022 Harald Sitter <sitter@kde.org>
+
+ecm_qt_declare_logging_category(nwindevices_SRCS
+    HEADER
+        nwindevices-logging.h
+    IDENTIFIER
+        LIBNWINDEVICES
+    CATEGORY_NAME
+        org.kde.libnwindevices
+    DESCRIPTION
+        "Library for nwin devices"
+    EXPORT
+        libnwindevices
+)
+
+qt_add_dbus_interface(nwindevices_SRCS "${NWIN_INPUTDEVICE_INTERFACE}" InputDevice_interface)
+
+add_library(nwindevices STATIC ${nwindevices_SRCS} devicesmodel.cpp devicesmodel.h inputdevice.cpp inputdevice.h)
+set_property(TARGET nwindevices PROPERTY POSITION_INDEPENDENT_CODE ON)
+target_link_libraries(nwindevices
+    Qt::Core
+    Qt::DBus
+    Qt::Gui
+)
+
+if(BUILD_TESTING)
+    add_subdirectory(tests)
+endif()
