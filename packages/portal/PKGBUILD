# Native NWin portal backend; installs alongside xdg-desktop-portal-kde.
pkgname=nwin-desktop-portal
pkgver=6.7.5
pkgrel=1
pkgdesc='Native NWin backend for xdg-desktop-portal'
arch=(x86_64)
url='https://kde.org/plasma-desktop/'
license=(LGPL-2.0-or-later)
options=(!debug)
# Runtime dependencies from Arch's xdg-desktop-portal-kde 6.7.5-1 metadata.
depends=(glibc
         kcmutils
         kconfig
         kcoreaddons
         kcrash
         kdeclarative
         kglobalaccel
         kiconthemes
         ki18n
         kio
         kio-fuse
         kirigami
         kirigami-addons
         kitemviews
         knotifications
         kpipewire
         kservice
         kstatusnotifieritem
         kwayland
         kwindowsystem
         libstdc++
         libxkbcommon
         plasma-workspace
         qt6-base
         qt6-declarative
         wayland
         xdg-desktop-portal
         nwin)
makedepends=(cmake
             ninja
             git
             extra-cmake-modules
             plasma-wayland-protocols
             wayland-protocols)
provides=(xdg-desktop-portal-impl)
source=("xdg-desktop-portal-kde::git+https://github.com/KDE/xdg-desktop-portal-kde.git#tag=v$pkgver"
        nwin-portal.patch)
sha256sums=('SKIP'
            'b3624187c9f026cb69f7c3d7b8aea003807cd47ae3f23415dc32c8df50144904')

prepare() {
  cd "$srcdir/xdg-desktop-portal-kde"
  git apply "$srcdir/nwin-portal.patch"
}

build() {
  cmake -B "$srcdir/build" -S "$srcdir/xdg-desktop-portal-kde" -G Ninja \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DKDE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build "$srcdir/build"
}

package() {
  # Runtime-only: the native workspace depends on this portal backend too.
  depends+=(nwin-plasma-workspace)
  DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
